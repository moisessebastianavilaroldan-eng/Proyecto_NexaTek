# ==============================================================================
# NEXATEK - VARIABLES DE ENTORNO (EJEMPLO)
# Copia este archivo a `.env` y completa con las credenciales reales de tu proyecto
# ==============================================================================

# Variables Públicas de Frontend (Vite)
# Obtén estos valores en tu consola de Supabase > Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Contacto y WhatsApp de NEXATEK (Opcional / Configurable)
# Coloca el número internacional con código de país sin signos, ej: 521XXXXXXXXXX
VITE_WHATSAPP_NUMBER=
# Mensaje inicial sugerido para WhatsApp
VITE_WHATSAPP_DEFAULT_MSG=Hola NEXATEK, me gustaría solicitar una cotización para un proyecto de software.
# Correo de contacto visible en el sitio
VITE_CONTACT_EMAIL=contacto@nexatek.com

# ==============================================================================
# Variables Privadas del Servidor (Edge Functions / Vercel Serverless / Resend)
# NUNCA compartas ni expongas estas variables con prefijo VITE_ en el frontend
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key-aqui
# RESEND_API_KEY=re_1234567890abcdef
# NOTIFICATION_RECEIVER_EMAIL=equipo@nexatek.com
